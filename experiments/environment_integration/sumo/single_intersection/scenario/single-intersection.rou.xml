<?xml version="1.0" encoding="UTF-8"?>

<!--
    A stochastic, non-stationary demand profile for one four-way intersection.
    Each approach has dedicated right, through, and protected-left movements.
-->
<routes>
    <vTypeDistribution id="mixed_traffic">
        <vType id="passenger" probability="0.82" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="13.89" guiShape="passenger"/>
        <vType id="delivery" probability="0.12" accel="1.8" decel="4.0" sigma="0.4" length="7.5" minGap="3.0" maxSpeed="12.0" guiShape="delivery"/>
        <vType id="bus" probability="0.06" accel="1.2" decel="3.5" sigma="0.3" length="12.0" minGap="3.0" maxSpeed="10.0" guiShape="bus"/>
    </vTypeDistribution>

    <route id="n_s" edges="n_t t_s"/>
    <route id="n_e" edges="n_t t_e"/>
    <route id="n_w" edges="n_t t_w"/>
    <route id="e_w" edges="e_t t_w"/>
    <route id="e_s" edges="e_t t_s"/>
    <route id="e_n" edges="e_t t_n"/>
    <route id="s_n" edges="s_t t_n"/>
    <route id="s_w" edges="s_t t_w"/>
    <route id="s_e" edges="s_t t_e"/>
    <route id="w_e" edges="w_t t_e"/>
    <route id="w_n" edges="w_t t_n"/>
    <route id="w_s" edges="w_t t_s"/>

    <!-- 00:00-20:00: north-south peak. -->
    <flow id="peak_ns_n_s" type="mixed_traffic" route="n_s" begin="0" end="1200" probability="0.18" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_n_e" type="mixed_traffic" route="n_e" begin="0" end="1200" probability="0.05" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_n_w" type="mixed_traffic" route="n_w" begin="0" end="1200" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_s_n" type="mixed_traffic" route="s_n" begin="0" end="1200" probability="0.14" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_s_w" type="mixed_traffic" route="s_w" begin="0" end="1200" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_s_e" type="mixed_traffic" route="s_e" begin="0" end="1200" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_e_w" type="mixed_traffic" route="e_w" begin="0" end="1200" probability="0.10" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_e_s" type="mixed_traffic" route="e_s" begin="0" end="1200" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_e_n" type="mixed_traffic" route="e_n" begin="0" end="1200" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_w_e" type="mixed_traffic" route="w_e" begin="0" end="1200" probability="0.10" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_w_n" type="mixed_traffic" route="w_n" begin="0" end="1200" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ns_w_s" type="mixed_traffic" route="w_s" begin="0" end="1200" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>

    <!-- 20:00-40:00: demand shifts to east-west. -->
    <flow id="peak_ew_n_s" type="mixed_traffic" route="n_s" begin="1200" end="2400" probability="0.09" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_n_e" type="mixed_traffic" route="n_e" begin="1200" end="2400" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_n_w" type="mixed_traffic" route="n_w" begin="1200" end="2400" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_s_n" type="mixed_traffic" route="s_n" begin="1200" end="2400" probability="0.09" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_s_w" type="mixed_traffic" route="s_w" begin="1200" end="2400" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_s_e" type="mixed_traffic" route="s_e" begin="1200" end="2400" probability="0.03" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_e_w" type="mixed_traffic" route="e_w" begin="1200" end="2400" probability="0.17" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_e_s" type="mixed_traffic" route="e_s" begin="1200" end="2400" probability="0.05" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_e_n" type="mixed_traffic" route="e_n" begin="1200" end="2400" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_w_e" type="mixed_traffic" route="w_e" begin="1200" end="2400" probability="0.16" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_w_n" type="mixed_traffic" route="w_n" begin="1200" end="2400" probability="0.05" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="peak_ew_w_s" type="mixed_traffic" route="w_s" begin="1200" end="2400" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>

    <!-- 40:00-60:00: balanced but turn-heavy traffic. -->
    <flow id="turns_n_s" type="mixed_traffic" route="n_s" begin="2400" end="3600" probability="0.11" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_n_e" type="mixed_traffic" route="n_e" begin="2400" end="3600" probability="0.06" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_n_w" type="mixed_traffic" route="n_w" begin="2400" end="3600" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_s_n" type="mixed_traffic" route="s_n" begin="2400" end="3600" probability="0.11" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_s_w" type="mixed_traffic" route="s_w" begin="2400" end="3600" probability="0.06" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_s_e" type="mixed_traffic" route="s_e" begin="2400" end="3600" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_e_w" type="mixed_traffic" route="e_w" begin="2400" end="3600" probability="0.11" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_e_s" type="mixed_traffic" route="e_s" begin="2400" end="3600" probability="0.06" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_e_n" type="mixed_traffic" route="e_n" begin="2400" end="3600" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_w_e" type="mixed_traffic" route="w_e" begin="2400" end="3600" probability="0.11" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_w_n" type="mixed_traffic" route="w_n" begin="2400" end="3600" probability="0.06" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="turns_w_s" type="mixed_traffic" route="w_s" begin="2400" end="3600" probability="0.04" departSpeed="max" departPos="base" departLane="best"/>
</routes>
